# Copy this file to ".env" and fill in the values.
# The .env file is ignored by git, so your secrets never leave this machine.

# ---- Required: the app will not start without these ----

# Where the database lives. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# Any long random string. It signs login cookies.
# Generate one by running:  openssl rand -base64 32
SESSION_SECRET=

# From platform.openai.com -> API keys. Used for memo generation.
OPENAI_API_KEY=

# ---- Optional: features that stay switched off without them ----

# Google Drive import. The entire contents of the service account key file
# you download from Google Cloud, pasted on ONE line inside single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=

# OneDrive import. All four are needed together.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# The email address of the account whose OneDrive holds the documents.
ONEDRIVE_USER=

# Market data. Prices and ETF returns.
ALPHA_VANTAGE_API_KEY=
# The 3-month Treasury bill rate, used as the risk-free rate.
FRED_API_KEY=
# Ticker lookup.
OPENFIGI_API_KEY=

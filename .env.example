# Copy this file to ".env" and fill in the values.
# The .env file is ignored by git, so your secrets never leave this machine.

# ---- Required: the app will not start without these ----

# Where the database lives. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# Any long random string. It signs login cookies.
# `npm run check-setup` prints a ready-made one you can paste here.
SESSION_SECRET=

# From platform.openai.com -> API keys. Used for memo generation.
OPENAI_API_KEY=

# ---- Optional: features that stay switched off without them ----

# Investment Library: fund documents filed under a Gmail label.
# Needs 2-Step Verification on, then an app password from
# myaccount.google.com/apppasswords. The spaces Google shows are fine to include.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Only if your label is not called "Investment Library".
GMAIL_LIBRARY_LABEL=

# OneDrive import. All four are needed together.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# The email address of the account whose OneDrive holds the documents.
ONEDRIVE_USER=

# Market data. Prices and ETF returns.
ALPHA_VANTAGE_API_KEY=
# The 3-month Treasury bill rate, used as the risk-free rate.
FRED_API_KEY=
# Ticker lookup.
OPENFIGI_API_KEY=
